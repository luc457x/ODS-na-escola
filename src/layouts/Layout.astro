---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Plantando Consciência - Educação Ambiental nas Escolas',
  description = 'Projeto de Educação Ambiental nas Escolas para formar cidadãos conscientes e sustentáveis.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://luc457x.github.io/ODS-na-escola/');
---

<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico" />

    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Lato:wght@300;400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <div class="scroll-container" id="scroll-wrapper">
      <main class="container" id="conteudo">
        <slot />
      </main>
    </div>
    <Footer />
    <script>
      const scrollWrapper = document.getElementById('scroll-wrapper');
      const footer = document.querySelector('.footer');

      if (scrollWrapper && footer) {
        const checkScroll = () => {
          // Reveal footer when within 30px of scroll end or if content fits without scrolling
          const isAtBottom =
            scrollWrapper.scrollHeight - scrollWrapper.scrollTop - scrollWrapper.clientHeight <= 30;
          if (isAtBottom) {
            footer.classList.add('visible');
          } else {
            footer.classList.remove('visible');
          }
        };

        scrollWrapper.addEventListener('scroll', checkScroll, { passive: true });
        window.addEventListener('resize', checkScroll, { passive: true });
        // Initial check once rendered
        checkScroll();
      }
    </script>
  </body>
</html>
